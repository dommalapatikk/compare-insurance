# Server-side only. Never prefix these with NEXT_PUBLIC_ or commit real values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Comma-separated frontend origins allowed to call FastAPI directly.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Used by the Next.js server-side proxy route.
COMPARE_API_URL=http://127.0.0.1:8000
